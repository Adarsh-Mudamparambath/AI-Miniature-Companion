<!--
  Keep the physics collider classes in player builds. The HUD status light and the placement reticle
  are made with GameObject.CreatePrimitive, which adds a collider; the phone AR scene has no physics
  objects of its own, so without this the build strips them ("class 'SphereCollider' doesn't exist").
-->
<linker>
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.Collider" preserve="all" />
    <type fullname="UnityEngine.SphereCollider" preserve="all" />
    <type fullname="UnityEngine.CapsuleCollider" preserve="all" />
    <type fullname="UnityEngine.BoxCollider" preserve="all" />
    <type fullname="UnityEngine.MeshCollider" preserve="all" />
  </assembly>
</linker>
