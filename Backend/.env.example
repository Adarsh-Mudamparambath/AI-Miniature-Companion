# Copy this file to ".env" (same folder) only if you want to change the defaults.
# The defaults are FREE and LOCAL: Whisper (hearing), Ollama llama3.2:3b (thinking), Piper (voice).
# No API keys are needed for the free setup.

MINI_CHAT_PROVIDER=ollama
MINI_STT_PROVIDER=whisper
MINI_TTS_PROVIDER=piper

# Free local options
MINI_OLLAMA_MODEL=llama3.2:3b
MINI_WHISPER_MODEL=small.en
# MINI_PIPER_VOICE=models/piper/en_US-amy-medium.onnx

# Optional PAID providers (only if you ever want them): set the provider names above to
# anthropic / openai and add your own keys here. Never put keys into Unity or the Quest app.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

MINI_HOST=127.0.0.1
MINI_PORT=8787
MINI_LANGUAGE=en
